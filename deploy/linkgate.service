[Unit]
Description=Linkgate transparent failover proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/linkgate -config /etc/linkgate/config.yaml
Restart=always
RestartSec=2
# 长连接流式响应：不要设置过短的 TimeoutStopSec 以外的写超时
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/linkgate

[Install]
WantedBy=multi-user.target
